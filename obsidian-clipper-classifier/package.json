{
  "name": "jev-clipper-classifier",
  "version": "0.1.0",
  "private": true,
  "description": "Classify Obsidian Web Clipper notes with Jev.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
